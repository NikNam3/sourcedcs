{
  "name": "crc-desktop",
  "version": "1.0.1",
  "description": "CRC — SOURCE DCS's desktop GCI/datalink client for DCS: World",
  "author": "SOURCE DCS",
  "desktopName": "CRC.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test 'tests/*.test.js'",
    "dev-check": "npm test && npm start",
    "release-check": "bash scripts/release-check.sh",
    "pack:linux": "electron-builder --linux AppImage --publish never",
    "pack:win": "electron-builder --win nsis --publish never",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dockview-core": "5.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "maplibre-gl": "3.6.2"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "page.sourcedcs.crc",
    "productName": "CRC",
    "directories": {
      "output": "dist",
      "app": ".",
      "buildResources": "build-assets"
    },
    "files": [
      "package.json",
      "main.js",
      "lxsrs-setup.js",
      "patch-notes.js",
      "config.json",
      "app/**/*",
      "!app/package.json",
      "!app/package-lock.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "synopsis": "SOURCE DCS GCI/datalink client",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "python-pkg",
          "to": "python-pkg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://sourcedcs.page/downloads"
      }
    ]
  }
}
