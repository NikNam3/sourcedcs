{
  "version": 8,
  "id": "crc-scope",
  "name": "CRC Scope",
  "sources": {
    "maptiler_attribution": {
      "attribution": "<a href=\"https://www.maptiler.com/copyright/\" target=\"_blank\">&copy; MapTiler</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a>",
      "type": "vector"
    },
    "maptiler_planet": {
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=__MAPTILER_KEY__",
      "type": "vector"
    }
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=__MAPTILER_KEY__",
  "sprite": "https://api.maptiler.com/maps/streets-v2-dark/sprite",
  "bearing": 0,
  "pitch": 0,
  "center": [
    0,
    0
  ],
  "zoom": 1,
  "layers": [
    {
      "id": "Background",
      "type": "background",
      "paint": {
        "background-color": "#0d0d0d"
      }
    },
    {
      "id": "Water",
      "type": "fill",
      "source": "maptiler_planet",
      "source-layer": "water",
      "paint": {
        "fill-color": "#080808",
        "fill-antialias": true
      }
    },
    {
      "id": "River",
      "type": "line",
      "source": "maptiler_planet",
      "source-layer": "waterway",
      "filter": [
        "!=",
        "brunnel",
        "tunnel"
      ],
      "paint": {
        "line-color": "#0f0f0f",
        "line-width": {
          "stops": [
            [
              10,
              0.5
            ],
            [
              16,
              2
            ]
          ]
        }
      }
    },
    {
      "id": "Country border",
      "type": "line",
      "source": "maptiler_planet",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          "admin_level",
          2
        ],
        [
          "==",
          "maritime",
          0
        ]
      ],
      "paint": {
        "line-color": "#2a2a2a",
        "line-width": {
          "stops": [
            [
              3,
              0.5
            ],
            [
              10,
              1.5
            ]
          ]
        },
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "Airport zone",
      "type": "fill",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 11,
      "filter": [
        "==",
        "$type",
        "Polygon"
      ],
      "paint": {
        "fill-color": "#111111",
        "fill-opacity": 1
      }
    },
    {
      "id": "Aeroway",
      "type": "line",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 5,
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          "runway",
          "#4a5a4a",
          "taxiway",
          "#2a3a2a",
          "#1a2a1a"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "runway"
            ],
            3,
            1
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "runway"
            ],
            14,
            6
          ],
          20,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "runway"
            ],
            22,
            10
          ]
        ]
      }
    },
    {
      "id": "Taxiway labels",
      "type": "symbol",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 13,
      "filter": [
        "==",
        "class",
        "taxiway"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{ref}",
        "text-font": [
          "Roboto Medium",
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              13,
              12
            ],
            [
              18,
              18
            ]
          ]
        },
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#5a6a5a",
        "text-halo-color": "#000",
        "text-halo-width": 1
      }
    },
    {
      "id": "Airport gate",
      "type": "symbol",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 15,
      "filter": [
        "==",
        "class",
        "gate"
      ],
      "layout": {
        "text-field": "{ref}",
        "text-font": [
          "Roboto Medium",
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              15,
              9
            ],
            [
              22,
              14
            ]
          ]
        },
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#5a6a5a",
        "text-halo-color": "#000",
        "text-halo-width": 1
      }
    },
    {
      "id": "Country labels",
      "type": "symbol",
      "source": "maptiler_planet",
      "source-layer": "place",
      "minzoom": 1,
      "maxzoom": 8,
      "filter": [
        "==",
        "class",
        "country"
      ],
      "layout": {
        "text-field": "{name:en}",
        "text-font": [
          "Roboto Medium",
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              2,
              10
            ],
            [
              6,
              13
            ]
          ]
        },
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#404040",
        "text-halo-color": "#000",
        "text-halo-width": 1
      }
    }
  ]
}