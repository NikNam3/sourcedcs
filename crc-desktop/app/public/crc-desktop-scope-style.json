{
  "version": 8,
  "id": "crc-scope",
  "name": "CRC Scope",
  "sources": {
    "maptiler_attribution": {
      "attribution": "<a href=\"https://www.maptiler.com/copyright/\" target=\"_blank\">&copy; MapTiler</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a>",
      "type": "vector"
    },
    "maptiler_planet": {
      "tiles": [
        "https://api.maptiler.com/tiles/v3/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "type": "vector"
    }
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "bearing": 0,
  "pitch": 0,
  "center": [
    0,
    0
  ],
  "zoom": 1,
  "layers": [
    {
      "id": "Background",
      "type": "background",
      "paint": {
        "background-color": "#0d0d0d"
      }
    },
    {
      "id": "Water",
      "type": "fill",
      "source": "maptiler_planet",
      "source-layer": "water",
      "paint": {
        "fill-color": "#080808",
        "fill-antialias": true
      }
    },
    {
      "id": "River",
      "type": "line",
      "source": "maptiler_planet",
      "source-layer": "waterway",
      "filter": [
        "!=",
        "brunnel",
        "tunnel"
      ],
      "paint": {
        "line-color": "#0f0f0f",
        "line-width": {
          "stops": [
            [
              10,
              0.5
            ],
            [
              16,
              2
            ]
          ]
        }
      }
    },
    {
      "id": "Country border",
      "type": "line",
      "source": "maptiler_planet",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          "admin_level",
          2
        ],
        [
          "==",
          "maritime",
          0
        ]
      ],
      "paint": {
        "line-color": "#2a2a2a",
        "line-width": {
          "stops": [
            [
              3,
              0.5
            ],
            [
              10,
              1.5
            ]
          ]
        },
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "Airport zone",
      "type": "fill",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "in",
          "class",
          "aerodrome",
          "heliport"
        ]
      ],
      "paint": {
        "fill-color": "#111111",
        "fill-opacity": 1
      }
    },
    {
      "id": "Airport pavement",
      "type": "fill",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "in",
          "class",
          "apron",
          "runway",
          "taxiway",
          "helipad"
        ]
      ],
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "runway",
          "#2e362e",
          "taxiway",
          "#262c26",
          "#1e231e"
        ],
        "fill-outline-color": "#2e362e",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0,
          13,
          1
        ]
      }
    },
    {
      "id": "Taxiway",
      "type": "line",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "==",
          "class",
          "taxiway"
        ]
      ],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#323c32",
        "line-width": [
          "interpolate",
          [
            "exponential",
            2
          ],
          [
            "zoom"
          ],
          12,
          0.75,
          14,
          2.5,
          16,
          10,
          18,
          40
        ]
      }
    },
    {
      "id": "Aeroway",
      "type": "line",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 5,
      "paint": {
        "line-color": "#4a5a4a",
        "line-width": [
          "interpolate",
          [
            "exponential",
            2
          ],
          [
            "zoom"
          ],
          5,
          1,
          11,
          2.5,
          14,
          6,
          16,
          24,
          18,
          94
        ]
      },
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "==",
          "class",
          "runway"
        ]
      ],
      "layout": {
        "line-cap": "butt"
      }
    },
    {
      "id": "Runway designators",
      "type": "symbol",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "==",
          "class",
          "runway"
        ],
        [
          "has",
          "ref"
        ]
      ],
      "layout": {
        "symbol-placement": "line-center",
        "text-field": [
          "get",
          "ref"
        ],
        "text-font": [
          "Roboto Medium",
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          11,
          16,
          15
        ],
        "text-letter-spacing": 0.1,
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#8a9a8a",
        "text-halo-color": "#000000",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "Taxiway labels",
      "type": "symbol",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "==",
          "class",
          "taxiway"
        ],
        [
          "has",
          "ref"
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "ref"
        ],
        "text-font": [
          "Roboto Medium",
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              13,
              12
            ],
            [
              18,
              18
            ]
          ]
        },
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#788878",
        "text-halo-color": "#000",
        "text-halo-width": 1
      }
    },
    {
      "id": "Apron labels",
      "type": "symbol",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 14,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "==",
          "class",
          "apron"
        ],
        [
          "has",
          "ref"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "ref"
        ],
        "text-font": [
          "Roboto Regular",
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          10,
          18,
          13
        ]
      },
      "paint": {
        "text-color": "#627062",
        "text-halo-color": "#000000",
        "text-halo-width": 1
      }
    },
    {
      "id": "Airport gate",
      "type": "symbol",
      "source": "maptiler_planet",
      "source-layer": "aeroway",
      "minzoom": 15,
      "filter": [
        "==",
        "class",
        "gate"
      ],
      "layout": {
        "text-field": "{ref}",
        "text-font": [
          "Roboto Medium",
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              15,
              9
            ],
            [
              22,
              14
            ]
          ]
        },
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#627062",
        "text-halo-color": "#000",
        "text-halo-width": 1
      }
    },
    {
      "id": "Country labels",
      "type": "symbol",
      "source": "maptiler_planet",
      "source-layer": "place",
      "minzoom": 1,
      "maxzoom": 8,
      "filter": [
        "==",
        "class",
        "country"
      ],
      "layout": {
        "text-field": "{name:en}",
        "text-font": [
          "Roboto Medium",
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              2,
              10
            ],
            [
              6,
              13
            ]
          ]
        },
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#404040",
        "text-halo-color": "#000",
        "text-halo-width": 1
      }
    }
  ]
}
