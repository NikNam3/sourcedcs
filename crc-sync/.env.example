# Copy to crc-sync/.env for local development.
# In production these are set via infra/docker-compose.yml + infra/.env instead —
# this file is only read when you run crc-sync directly with `npm start`.

PORT=3000

# ── Casdoor OAuth ────────────────────────────────────────────────────────────
CASDOOR_ENDPOINT=https://auth.sourcedcs.page
CRCSYNC_CLIENT_ID=
CRCSYNC_CLIENT_SECRET=

# ── DCS-gRPC / SRS upstream — defaults match the shared DCS server ──────────
# crc-sync reads CRCSYNC_DCS_GRPC_HOST / CRCSYNC_SRS_HOST / CRCSYNC_SRS_PORT (the root .env names, which compose passes
# straight through) and falls back to these bare names, so either works here.
DCS_GRPC_HOST=server.sourcedcs.page:50051
SRS_HOST=server.sourcedcs.page
SRS_PORT=5002
# DCS-gRPC unit stream tuning: leave unset (defaults 1 s poll, 5 s max backoff; see the root .env.example).
# DCS_GRPC_POLL_RATE=
# DCS_GRPC_MAX_BACKOFF=

# MapTiler: the terrain-masking key (src/terrain.js), and the key handed to crc-desktop after login
# (GET /api/client-config; CRCSYNC_MAPTILER_CLIENT_KEY wins, else the terrain key). Both optional.
CRCSYNC_MAPTILER_KEY=
CRCSYNC_MAPTILER_CLIENT_KEY=
# OPTIONAL: where update-required (docs/adr/0103) points an out-of-date crc-desktop. Unset: the frame carries no link.
# CRCSYNC_DOWNLOAD_URL=https://sourcedcs.page/download.html

# ── Airspace registry (docs/adr/0098 §9) ─────────────────────────────────────
# Shared secret for sourcedcs-web's server-to-server calls (/api/airspace-registry/*) and for this service's pull of
# /api/bookings/service/upcoming from sourcedcs-web. Unset: the registry API answers 503 and no calendar is pulled.
AIRSPACE_SERVICE_TOKEN=
# OPTIONAL: where the booking calendar's link points (the web's public base URL). Unset: the link is omitted.
# CRCSYNC_SOURCEDCS_WEB_PUBLIC_URL=https://sourcedcs.page
# Where this service reaches sourcedcs-web for the calendar pull and flight plans (default http://localhost:7000). The
# mirror image, web -> crc-sync, is SOURCEDCS_CRCSYNC_URL, read by sourcedcs-web (default http://localhost:3000).
# CRCSYNC_SOURCEDCS_WEB_URL=http://localhost:7000

# ── EFSP flight plans ────────────────────────────────────────────────────────
# Shared secret for pulling every filed DD1801 from sourcedcs-web (GET /api/fpl1801/service/all). Must equal the web's
# FLIGHT_PLAN_SERVICE_TOKEN. Unset: the ops-filed queue is empty with "not configured"; the web answers 503 when it has
# none, 401 for a wrong one.
FLIGHT_PLAN_SERVICE_TOKEN=


# ── Advanced / test only — leave all of these unset in production ────────────
# Every file crc-sync reads or writes lives under CRCSYNC_CONFIG_DIR / CRCSYNC_STATE_DIR (docs/adr/0048); setting
# CRCSYNC_STATE_DIR is the supported way to point a run at a scratch directory. The per-file overrides below predate it:
# each one moves a single file (read and write) and exists so a test or the e2e harness can use a temp copy. A wrong
# value here is read as "that file is missing", so a typo presents as a reset. Documented here, not recommended.
# CRCSYNC_EFSP_BOARD_SNAPSHOT_PATH=      # the Board snapshot (efsp-board.json)
# CRCSYNC_EFSP_MUTATION_LOG_PATH=        # the Mutation audit log (efsp-mutations.jsonl)
# CRCSYNC_EFSP_METRICS_PATH=             # efsp-metrics.json
# CRCSYNC_EFSP_TRAFFIC_COUNT_PATH=       # efsp-traffic-count.jsonl
# CRCSYNC_EFSP_AIRSPACES_PATH=           # the airspace definitions (efsp-airspaces.json)
# CRCSYNC_EFSP_CARRIERS_PATH=            # carrier hull config
# CRCSYNC_EFSP_STEREO_ROUTES_PATH=       # efsp-stereo-routes.json
# CRCSYNC_EFSP_SURVEILLANCE_HINTS_PATH=  # surveillance-hints config
# CRCSYNC_EFSP_INSTRUMENTATION_CONFIG_PATH=
# CRCSYNC_EFSP_FACILITY_CONFIG_PATH=         # the facility file, one per Facility:
# CRCSYNC_EFSP_FACILITY_CONFIG_PATH_CENTER=
# CRCSYNC_EFSP_FACILITY_CONFIG_PATH_TACTICAL=
# CRCSYNC_EFSP_FACILITY_CONFIG_PATH_CARRIER=
# CRCSYNC_COLLAB_PATH=                   # the collaborative overlay (collab-overlay.json)
# CRCSYNC_MISSION_SESSION_PATH=          # the mission-session file
# CRCSYNC_APT_CONFIG_PATH=               # per-airport ATIS config (apt-config.json)
# CRCSYNC_COMM_CARD_PATH=                # the comm card layer
# CRCSYNC_SENSOR_SPECS_PATH=             # radar sensor specs
# DCS_GRPC_PROTO_PATH=                   # where the DCS-gRPC .proto files are (default ./protos)
# Playwright harness only. CRCSYNC_TEST_RESET=1 mounts the test-reset routes (src/test-reset.js) (never set it on a served instance);
# CRCSYNC_NLA_GUARD_MS then shortens the NLA double-tap guard, and only with that flag.
# CRCSYNC_TEST_RESET=
# CRCSYNC_NLA_GUARD_MS=
# CRCSYNC_CONTROL_INVARIANT=throw        # a control-release violation throws (the tests); unset: it repairs and alerts
