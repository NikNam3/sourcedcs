{
  "name": "crc-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Central multiplayer sync + view-only web GCI for crc-desktop",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --import ./tests/helpers/isolate-state.mjs --test tests/*.test.mjs",
    "freeze": "node --import ./tests/helpers/isolate-state.mjs --test tests/freeze/freeze-*.test.mjs",
    "walk": "CRCSYNC_WALK_DEPTH=4 node --import ./tests/helpers/isolate-state.mjs --test tests/control-release-invariant.test.mjs",
    "wire:record": "node tools/wire-record.js",
    "soak": "node tools/soak/run.js",
    "soak:smoke": "node tools/soak/run.js --profile smoke --minutes 20",
    "soak:selfcheck": "node --import ./tests/helpers/isolate-state.mjs tools/soak/selfcheck.mjs",
    "terrain:build": "node tools/terrain/cli.js build",
    "terrain:validate": "node tools/terrain/cli.js validate",
    "freeze:update": "UPDATE_GOLDEN=1 node --import ./tests/helpers/isolate-state.mjs --test tests/freeze/freeze-*.test.mjs",
    "freeze:selfcheck": "node --import ./tests/helpers/isolate-state.mjs tests/freeze/freeze-selfcheck.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "ws": "^8.18.0"
  }
}
