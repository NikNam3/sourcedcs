# ── SOURCE DCS — environment variables ──────────────────────────────────────
# Copy this file to infra/.env (next to docker-compose.yml) and fill in values.

# ── Image tag ────────────────────────────────────────────────────────────────
# Tag of the published atobrief / sourcedcs-web / crc-sync images compose runs
# (ghcr.io/niknam3/sourcedcs/<name>:TAG). deploy.yml sets it; leave it unset
# (= latest) unless pinning a release.
#TAG=latest

# ── Databases (MariaDB, MediaWiki, Casdoor) ──────────────────────────────────
# MYSQL_ROOT_PASSWORD and the two service passwords are read by mariadb's init
# script on FIRST start of the mariadb-data volume only; changing them later
# does not change the live database (see infra/RUNBOOK.md).
MYSQL_ROOT_PASSWORD=
WIKI_DB_PASSWORD=
CASDOOR_DB_USER=
CASDOOR_DB_PASSWORD=

# ── Casdoor OAuth (shared) ───────────────────────────────────────────────────
CASDOOR_ENDPOINT=
CASDOOR_CLIENT_SECRET=

# ── Casdoor OAuth — sourcedcs-web client ────────────────────────────────────
CASDOOR_CLIENT_ID=

# ── Casdoor OAuth — atobrief client ─────────────────────────────────────────
ATOBRIEF_CLIENT_ID=
ATOBRIEF_CLIENT_SECRET=

# ── Casdoor OAuth — crc-sync client ─────────────────────────────────────────
CRCSYNC_CLIENT_ID=
CRCSYNC_CLIENT_SECRET=

# ── crc-desktop release uploads ──────────────────────────────────────────────
# Shared secret the crc-desktop-release GitHub Actions workflow uses to
# upload installers/manifests to sourcedcs-web's /api/releases/upload —
# also set as the RELEASE_UPLOAD_TOKEN repo secret in GitHub.
RELEASE_UPLOAD_TOKEN=

# ── EFSP flight-plan service access ──────────────────────────────────────────
# Shared secret crc-sync uses to call sourcedcs-web's GET /api/fpl1801/
# service/all (every currently-filed DD1801 plan, for EFSP's ops-filed
# queue) — sourcedcs-web has no interactive Casdoor session to grant crc-sync
# controller/admin access, so this is a dedicated service credential instead
# (same shape as RELEASE_UPLOAD_TOKEN above). Must be identical on both
# sides — set once here, read by both sourcedcs-web (validates) and
# crc-sync (sends).
FLIGHT_PLAN_SERVICE_TOKEN=

# ── atobrief USMTF ATO service access ────────────────────────────────────────
# Shared secret for reading a package as a USMTF ATO from atobrief
# (GET /api/rooms/:id/ato.usmtf, POST /api/usmtf — docs/adr/0078). atobrief
# validates it. Nothing sends it today: crc-sync never reads it, and its ATO
# import (lane L14) takes a pasted or dropped USMTF file rather than fetching
# from atobrief. Set it only for an external consumer. Unset, the service path
# is disabled and only a signed-in user's token works.
ATOBRIEF_USMTF_TOKEN=

# ── Domains ───────────────────────────────────────────────────────────────────
DOMAIN=
WIKI_DOMAIN=
AUTH_DOMAIN=
ATOBRIEF_DOMAIN=
ASACS_DOMAIN=

# ── External links (shown on the site) ───────────────────────────────────────
DISCORD_URL=https://discord.gg/sourcedcs
WIKI_URL=https://wiki.sourcedcs.page
ATO_URL=https://ato.sourcedcs.page
OLYMPUS_URL=https://olympus.sourcedcs.page
ASACS_URL=https://asacs.sourcedcs.page
GITHUB_URL=https://github.com/NikNam3/sourcedcs

# ── crc-sync — DCS-gRPC / SRS upstream ──────────────────────────────────────
# crc-sync is the sole gRPC + SRS client on behalf of every crc-desktop
# instance (see crc-sync/). Defaults match the shared DCS server; only
# override if crc-sync needs to point somewhere else.
CRCSYNC_DCS_GRPC_HOST=server.sourcedcs.page:50051
CRCSYNC_SRS_HOST=server.sourcedcs.page
CRCSYNC_SRS_PORT=5002

# Which DCS coalition is "own" for crc-sync: 3 = BLUE (default), 2 = RED. It
# models the Mode 4 crypto key (crc-sync/src/surveillance/iff.js), so a RED-side
# squadron MUST set 2 or every Mode 4 reply is judged against the wrong key.
# Two coalitions controlled at once means two crc-sync servers, one each.
CRCSYNC_COALITION=3

# DCS-gRPC unit stream tuning (crc-sync/src/grpc-client.js). Leave both unset:
# the defaults are the intended values. DCS_GRPC_POLL_RATE is the seconds
# between unit polls (default 1, floor 1 — a 0 made DCS-gRPC panic after the
# full sync and the stream reconnected in a tight loop). DCS_GRPC_MAX_BACKOFF
# is the longest DCS-gRPC waits before re-polling a unit that isn't changing
# (seconds, default 5, never below the poll rate).
DCS_GRPC_POLL_RATE=
DCS_GRPC_MAX_BACKOFF=

# EFSP CreateStrip pre-fill — crc-sync looks up a pilot-submitted DD1801
# flight plan from sourcedcs-web by callsign (GET /api/fpl1801/by-callsign/
# :callsign, public). In the Docker stack this is the main-website
# container's internal address (both are on the shared `web` network, see
# infra/docker-compose.yml) — only override for a non-standard topology.
# sourcedcs-web being unreachable degrades gracefully (no Strip creation is
# ever blocked by this); see crc-sync/src/efsp/flight-plan-lookup.js.
CRCSYNC_SOURCEDCS_WEB_URL=http://main-website:7000

# Terrain masking for the radar picture. crc-sync computes radar line of sight
# itself now (docs/adr/0044) and samples MapTiler terrain-RGB tiles to do it,
# caching them to CRCSYNC_TERRAIN_CACHE_DIR so a restart does not re-fetch the
# theater. OPTIONAL: with no key the picture works exactly as it does with one,
# except that terrain masks nothing and every radar sees to its full range —
# crc-sync logs that once at startup rather than failing.
CRCSYNC_MAPTILER_KEY=
# Local runs only (commented out: compose does not forward it). Defaults to
# crc-sync/state/terrain-cache; the Docker stack hardcodes it to a volume (infra/docker-compose.yml's crc-sync-state).
#CRCSYNC_TERRAIN_CACHE_DIR=

# Where crc-sync keeps shipped defaults versus runtime state (docs/adr/0048).
# config/ is baked into the image and read-only in practice; state/ holds
# everything the service writes — the EFSP Board, the Mutation log, the squawk
# map, theater settings, ATIS config, airspace definitions. A read prefers
# state/ and falls back to the shipped default. (crc-sync/data/ is a third
# thing again: shipped read-only reference tables, never written.) Both default
# to the paths beside the source and only need setting for an unusual layout;
# the Docker stack leaves them alone and mounts a volume at /app/state
# (commented out: compose does not forward them).
#CRCSYNC_CONFIG_DIR=
#CRCSYNC_STATE_DIR=

# ── Discord bot ───────────────────────────────────────────────────────────────
# Bot token — required for live roster fetching and application notifications.
DISCORD_BOT_TOKEN=

# Guild (server) ID — required for live roster fetching.
DISCORD_GUILD_ID=

# Channel ID where new applications are posted as embeds.
# If not set, applications fall back to local JSON storage.
APPLY_CHANNEL_ID=

# Channel ID where skill grading requests are posted (sourcedcs-web).
GRADING_CHANNEL_ID=
